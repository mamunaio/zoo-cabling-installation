---
import { business } from '../../config/business';

interface FAQItem {
  id: string;
  index: string;
  question: string;
  highlights: readonly string[];
  paragraphs: readonly string[];
}

const faqItems: readonly FAQItem[] = [
  {
    id: 'cat6-vs-cat6a',
    index: '01',
    question: 'Cat6 vs Cat6A: Which should I choose?',
    highlights: ['Up to 10 Gbps Transmission', 'Pure Solid Copper', 'Residential & Commercial Value'],
    paragraphs: [
      'For the vast majority of residential homes and standard office environments, high-grade pure copper Cat6 is the optimal choice. Cat6 reliably supports speeds up to 10 Gbps over shorter runs (typically up to 37–55 metres depending on crosstalk and routing) and standard 1 Gbps up to the full 100-metre specification.',
      'Cat6A (Augmented) features heavier shielding and tighter pair-twisting to support 10 Gbps transmission across full 100-metre distances with higher resistance to alien crosstalk. It is ideal for dense commercial server racks, data centres, or new builds seeking ultimate future-proofing. However, because Cat6A is thicker and less flexible, standard pure copper Cat6 offers the ideal balance of speed, route flexibility, and value for everyday installations.',
    ],
  },
  {
    id: 'ethernet-port-cost',
    index: '02',
    question: 'How much does an Ethernet port installation cost?',
    highlights: ['Transparent Upfront Quotes', 'Multi-Port Volume Savings', 'Zero Hidden Fees'],
    paragraphs: [
      'Pricing depends on the specific requirements of your property rather than an arbitrary flat rate. Key factors include your building structure (single-storey homes with accessible ceiling spaces are simpler than multi-storey dwellings or solid brick/concrete walls), cabling pathway access, and the distance from your central router or patch panel to each outlet.',
      'Installing multiple data points during the same visit significantly reduces the cost per port because setup time and cable-pull pathways are shared. We provide clear, upfront quotes based on your exact layout before starting any work—with no hidden fees.',
    ],
  },
  {
    id: 'acma-licensed',
    index: '03',
    question: 'Are you ACMA licensed and appropriately endorsed?',
    highlights: ['ACMA Open Cabling License', 'AS/CA S009 & AS/NZS 3080', 'TCA1 Compliance Certification'],
    paragraphs: [
      'Yes, 100%. Under Australian telecommunications regulations, any fixed cabling connected to the telecommunications network (including NBN-connected premises) must legally be installed by an ACMA-registered cabler.',
      'We hold current ACMA Open Cabling registrations with verified endorsements for structured Cat6/Cat6A and optical fibre cabling. Every job is completed in strict accordance with Australian Standards (AS/CA S009 and AS/NZS 3080) and certified with digital testers upon completion.',
    ],
  },
  {
    id: 'concealed-cavity-walls',
    index: '04',
    question: 'Can cables be concealed inside existing cavity walls without surface conduit?',
    highlights: ['Cavity Wall Fishing', 'Flush Clipsal Wall Plates', 'No Ugly Surface Plastic'],
    paragraphs: [
      'Yes. In the vast majority of Australian residential and commercial properties with standard plasterboard cavity walls and ceiling or sub-floor access, cables are routed completely out of sight within the wall cavity.',
      'We fish cables through the internal wall frames using specialized rods and install premium flush-mounted Clipsal faceplates that blend seamlessly with your existing electrical points. Surface conduit is only ever used as a last resort on solid masonry walls, and always discussed with you first.',
    ],
  },
  {
    id: 'wifi-ap-poe-cameras',
    index: '05',
    question: 'Do you install cabling for UniFi / Wi-Fi Access Points and PoE cameras?',
    highlights: ['High-Power PoE+ Support', 'Ceiling Mount Drops', 'Clean Patch Panel Racks'],
    paragraphs: [
      'Absolutely. Ceiling-mounted wireless access points (like Ubiquiti UniFi, TP-Link Omada, or Aruba) and PoE security cameras are among our most frequent installations.',
      'We run dedicated, solid copper Cat6 lines directly from your central network switch or patch panel to ceiling points or external eaves, providing both gigabit data and Power-over-Ethernet (PoE/PoE+) without needing separate power points.',
    ],
  },
];
---

<section class="faq-section" id="faq" aria-labelledby="faq-heading">
  <!-- Subtle Atmospheric Backdrop Elements -->
  <div class="faq-ambient-glow faq-ambient-left" aria-hidden="true"></div>
  <div class="faq-ambient-glow faq-ambient-right" aria-hidden="true"></div>
  <div class="faq-grid-pattern" aria-hidden="true"></div>

  <div class="container faq-container">
    <div class="faq-grid">
      <!-- Left Column: Section Intro & Direct Contact Help -->
      <div class="faq-intro">
        <!-- Eyebrow Badge -->
        <div class="faq-eyebrow">
          <span class="eyebrow-ping" aria-hidden="true"></span>
          <span class="eyebrow-text">Frequently Asked Questions</span>
        </div>

        <h2 id="faq-heading" class="faq-title">
          Clear answers to common <span class="title-highlight">cabling questions</span>.
        </h2>

        <p class="faq-lead">
          Everything you need to know about structured Cat6 cabling, installation costs, and Australian telecommunications compliance before getting started.
        </p>

        <!-- Upgraded High-Tech Specialist Support Card -->
        <div class="faq-help-card">
          <div class="card-ambient-accent" aria-hidden="true"></div>

          <!-- Top Profile Header: Avatar & Specialist Details -->
          <div class="specialist-top-row">
            <div class="specialist-avatar-wrap">
              <img
                src="/images/Richard.png"
                alt="Richard - Lead Cabling Specialist"
                class="specialist-avatar"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <span class="avatar-status-dot" title="Available for technician consultations" aria-hidden="true"></span>
            </div>
            <div class="specialist-titles">
              <span class="specialist-name-role">Richard • Lead Cabler</span>
              <span class="specialist-status-text">ACMA Open Cabling Registered</span>
            </div>
            <span class="specialist-direct-badge">Direct Access</span>
          </div>

          <!-- Card Main Content -->
          <div class="help-card-body">
            <h3 class="help-card-title">Have a property-specific question?</h3>
            <p class="help-copy">
              Every building layout is unique. Speak directly with Richard for practical advice on cable pathways, wall cavities, and data point positioning.
            </p>
          </div>

          <!-- Interactive Action Buttons -->
          <div class="help-actions">
            <a href={`tel:${business.phoneTel}`} class="help-btn-primary" aria-label={`Call Richard on ${business.phone}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="btn-icon" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Call {business.phone}</span>
            </a>
            <a href="#quote" class="help-btn-secondary">
              <span>Request Upfront Quote</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-arrow" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

          <!-- Trust Signals Footnote -->
          <div class="help-footer-notes">
            <span class="trust-tag">
              <svg viewBox="0 0 20 20" fill="currentColor" class="tag-check" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>No Obligation</span>
            </span>
            <span class="trust-tag">
              <svg viewBox="0 0 20 20" fill="currentColor" class="tag-check" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Upfront Pricing</span>
            </span>
            <span class="trust-tag">
              <svg viewBox="0 0 20 20" fill="currentColor" class="tag-check" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Verified Test Reports</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Accordion Items with Silky Smooth Grid Height Transition -->
      <div class="faq-list-col">
        <div class="faq-accordion" role="region" aria-label="Frequently asked questions list">
          {faqItems.map((item, index) => (
            <div class={`faq-item ${index === 0 ? 'is-open' : ''}`} data-faq-id={item.id}>
              <button
                type="button"
                class="faq-trigger"
                aria-expanded={index === 0 ? 'true' : 'false'}
                aria-controls={`faq-panel-${item.id}`}
                id={`faq-btn-${item.id}`}
              >
                <div class="trigger-left">
                  <span class="faq-index-badge" aria-hidden="true">{item.index}</span>
                  <span class="faq-question-text">{item.question}</span>
                </div>
                <div class="faq-toggle-btn" aria-hidden="true">
                  <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </div>
              </button>

              <!-- Animated Collapse Panel (CSS Grid Transition) -->
              <div
                id={`faq-panel-${item.id}`}
                class="faq-collapse-panel"
                role="region"
                aria-labelledby={`faq-btn-${item.id}`}
              >
                <div class="faq-inner-body">
                  <div class="faq-body-divider" aria-hidden="true"></div>

                  <!-- Highlights Pills for Fast Scanning -->
                  {item.highlights && (
                    <div class="faq-highlights-row" aria-label="Key takeaway topics">
                      {item.highlights.map((tag) => (
                        <span class="highlight-pill">{tag}</span>
                      ))}
                    </div>
                  )}

                  <!-- Paragraph Answers -->
                  <div class="faq-text-paragraphs">
                    {item.paragraphs.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Silky Smooth Accessible Accordion with CSS Grid transition & exclusive toggle
  function initFAQ() {
    const accordion = document.querySelector('.faq-accordion');
    if (!accordion) return;

    const items = accordion.querySelectorAll<HTMLElement>('.faq-item');

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Close all other accordion items smoothly
        items.forEach((other) => {
          if (other !== item && other.classList.contains('is-open')) {
            other.classList.remove('is-open');
            const otherBtn = other.querySelector<HTMLButtonElement>('.faq-trigger');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
          }
        });

        // Toggle current item
        if (isOpen) {
          item.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  // Run on initial load and handle Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAQ);
  } else {
    initFAQ();
  }
  document.addEventListener('astro:page-load', initFAQ);
</script>

<style>
  /* ------------------------------------------------------------
     FAQ Section: Cinematic Tech Architecture
     ------------------------------------------------------------ */
  .faq-section {
    position: relative;
    padding-block: var(--section-padding-y);
    background-color: var(--color-bg-base);
    border-top: 1px solid var(--color-border);
    overflow: hidden;
  }

  /* Atmospheric Light Glows */
  .faq-ambient-glow {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(100px);
    z-index: 1;
  }

  .faq-ambient-left {
    top: 5%;
    left: -120px;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.08) 0%, rgba(37, 99, 235, 0.03) 50%, transparent 70%);
  }

  .faq-ambient-right {
    bottom: 5%;
    right: -100px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.06) 0%, rgba(37, 99, 235, 0.04) 50%, transparent 70%);
  }

  .faq-grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(15, 23, 42, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 23, 42, 0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
    z-index: 1;
    mask-image: radial-gradient(circle at 50% 50%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 20%, transparent 80%);
  }

  .faq-container {
    position: relative;
    z-index: 10;
  }

  /* 2-Column Section Grid with Balanced Proportions */
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: 1fr 1.35fr;
      gap: 3.5rem;
      align-items: start;
    }
  }

  @media (min-width: 1280px) {
    .faq-grid {
      grid-template-columns: 1fr 1.4fr;
      gap: 4.5rem;
    }
  }

  /* ------------------------------------------------------------
     Left Column: Header & Specialist Help Card
     ------------------------------------------------------------ */
  .faq-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Eyebrow Pill */
  .faq-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.28);
    margin-bottom: var(--space-1);
  }

  .eyebrow-ping {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-cta);
    box-shadow: 0 0 8px var(--color-cta);
    flex-shrink: 0;
  }

  .eyebrow-text {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-cta);
  }

  .faq-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .title-highlight {
    color: var(--color-cta);
    background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .faq-lead {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-body);
    max-width: 44ch;
    margin: 0;
  }

  /* ------------------------------------------------------------
     Glassmorphic Specialist Help Card (Clean, Uncramped Alignment)
     ------------------------------------------------------------ */
  .faq-help-card {
    position: relative;
    margin-top: var(--space-3);
    padding: clamp(1.35rem, 3vw, 1.85rem);
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    overflow: hidden;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .faq-help-card:hover {
    border-color: rgba(37, 99, 235, 0.35);
    box-shadow: 0 14px 34px -8px rgba(15, 23, 42, 0.08);
  }

  .card-ambient-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(to right, transparent, rgba(14, 165, 233, 0.6), rgba(249, 115, 22, 0.6), transparent);
    pointer-events: none;
  }

  /* Specialist Profile Row */
  .specialist-top-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .specialist-avatar-wrap {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid rgba(14, 165, 233, 0.4);
    padding: 2px;
    background: #f1f5f9;
    flex-shrink: 0;
  }

  .specialist-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .avatar-status-dot {
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background-color: var(--color-success);
    border: 2px solid #ffffff;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
  }

  .specialist-titles {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 140px;
  }

  .specialist-name-role {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.2;
  }

  .specialist-status-text {
    font-size: 0.6875rem;
    color: var(--color-brand);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .specialist-direct-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-cta);
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.25);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-full);
  }

  /* Help Card Copy */
  .help-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .help-card-title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.35;
    margin: 0;
  }

  .help-copy {
    font-size: var(--text-xs);
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Action Buttons */
  .help-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5, 0.625rem);
  }

  @media (min-width: 480px) {
    .help-actions {
      flex-direction: row;
      align-items: center;
      gap: var(--space-3);
    }
  }

  .help-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    background-color: var(--color-cta);
    color: var(--color-cta-contrast);
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: 0 4px 14px -2px rgba(249, 115, 22, 0.4);
    transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .help-btn-primary:hover {
    background-color: var(--color-cta-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px -2px rgba(249, 115, 22, 0.55);
  }

  .btn-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .help-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.65rem 1rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-main);
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }

  .help-btn-secondary:hover {
    background: var(--color-brand-tint);
    border-color: var(--color-brand);
    color: var(--color-brand);
    transform: translateY(-1px);
  }

  .btn-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .help-btn-secondary:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Footnote Tags */
  .help-footer-notes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .trust-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .tag-check {
    width: 13px;
    height: 13px;
    color: var(--color-success);
    flex-shrink: 0;
  }

  /* ------------------------------------------------------------
     Right Column: Engineered Accordion Items
     ------------------------------------------------------------ */
  .faq-list-col {
    width: 100%;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    transition: border-color var(--transition-base), background var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
  }

  .faq-item:hover {
    border-color: rgba(37, 99, 235, 0.3);
    background: #ffffff;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    transform: translateY(-1px);
  }

  .faq-item.is-open {
    border-color: rgba(37, 99, 235, 0.4);
    background: #ffffff;
    box-shadow:
      0 6px 20px -4px rgba(15, 23, 42, 0.08),
      0 0 0 1px rgba(37, 99, 235, 0.1);
  }

  /* Trigger Button: Clean, Edge-to-Edge, Accessible */
  .faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    padding: clamp(1.15rem, 2.5vw, 1.45rem) clamp(1.25rem, 3vw, 1.75rem);
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    user-select: none;
    text-align: left;
    transition: background-color var(--transition-fast);
  }

  .faq-trigger:focus-visible {
    outline: none;
    box-shadow: var(--ring-focus);
