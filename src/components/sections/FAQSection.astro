---
import { business } from '../../config/business';

interface FAQItem {
  id: string;
  question: string;
  paragraphs: readonly string[];
}

const faqItems: readonly FAQItem[] = [
  {
    id: 'cat6-vs-cat6a',
    question: 'Cat6 vs Cat6A: Which should I choose?',
    paragraphs: [
      'For the vast majority of residential homes and standard office environments, high-grade pure copper Cat6 is the optimal choice. Cat6 reliably supports speeds up to 10 Gbps over shorter runs (typically up to 37–55 metres depending on crosstalk and routing) and standard 1 Gbps up to the full 100-metre specification.',
      'Cat6A (Augmented) features heavier shielding and tighter pair-twisting to support 10 Gbps transmission across full 100-metre distances with higher resistance to alien crosstalk. It is ideal for dense commercial server racks, data centres, or new builds seeking ultimate future-proofing. However, because Cat6A is thicker and less flexible, standard pure copper Cat6 offers the ideal balance of speed, route flexibility, and value for everyday installations.',
    ],
  },
  {
    id: 'ethernet-port-cost',
    question: 'How much does an Ethernet port installation cost?',
    paragraphs: [
      'Pricing depends on the specific requirements of your property rather than an arbitrary flat rate. Key factors include your building structure (single-storey homes with accessible ceiling spaces are simpler than multi-storey dwellings or solid brick/concrete walls), cabling pathway access, and the distance from your central router or patch panel to each outlet.',
      'Installing multiple data points during the same visit significantly reduces the cost per port because setup time and cable-pull pathways are shared. We provide clear, upfront quotes based on your exact layout before starting any work—with no hidden fees.',
    ],
  },
  {
    id: 'acma-licensed',
    question: 'Are you ACMA licensed and appropriately endorsed?',
    paragraphs: [
      'Yes, 100%. Under Australian telecommunications regulations, any fixed cabling connected to the telecommunications network (including NBN-connected premises) must legally be installed by an ACMA-registered cabler.',
      'We hold current ACMA Open Cabling registrations with verified endorsements for structured Cat6/Cat6A and optical fibre cabling. Every job is completed in strict accordance with Australian Standards (AS/CA S009 and AS/NZS 3080) and certified with digital testers upon completion.',
    ],
  },
];
---

<section class="faq-section" id="faq" aria-labelledby="faq-heading">
  <div class="container faq-container">
    <div class="faq-grid">
      <!-- Left Column: Section Intro & Direct Contact Help -->
      <div class="faq-intro">
        <div class="faq-eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>Frequently Asked Questions</span>
        </div>

        <h2 id="faq-heading" class="faq-title">
          Clear answers to common cabling questions.
        </h2>

        <p class="faq-lead">
          Everything you need to know about structured Cat6 cabling, installation costs, and Australian telecommunications compliance before getting started.
        </p>

        <!-- Help Card linking to Quote Form / Phone -->
        <div class="faq-help-card">
          <div class="help-header">
            <svg class="help-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span class="help-heading">Have a property-specific question?</span>
          </div>
          <p class="help-copy">
            Every building layout is unique. Speak directly with Richard for advice on cable paths and data point positioning.
          </p>
          <div class="help-actions">
            <a href={`tel:${business.phoneTel}`} class="help-btn help-btn-phone" aria-label={`Call Richard on ${business.phone}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Call {business.phone}</span>
            </a>
            <a href="#quote" class="help-link">
              <span>Request Upfront Quote</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="link-arrow" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Accordion Items -->
      <div class="faq-list-col">
        <div class="faq-accordion" role="region" aria-label="Frequently asked questions list">
          {faqItems.map((item, index) => (
            <details class="faq-item" name="faq-group" open={index === 0}>
              <summary class="faq-summary">
                <span class="faq-question-text">{item.question}</span>
                <span class="faq-icon-wrapper" aria-hidden="true">
                  <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                {item.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement for exclusive accordion behavior across browsers
  const accordion = document.querySelector('.faq-accordion');
  if (accordion) {
    const items = accordion.querySelectorAll<HTMLDetailsElement>('details.faq-item');
    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (item.open) {
          items.forEach((other) => {
            if (other !== item && other.open) {
              other.open = false;
            }
          });
        }
      });
    });
  }
</script>

<style>
  .faq-section {
    padding-block: var(--section-padding-y);
    background-color: var(--color-bg-surface);
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: 0.95fr 1.25fr;
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  /* ------------------------------------------------------------
     Left Column: Intro & Help Card
     ------------------------------------------------------------ */
  .faq-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-cta);
  }

  .eyebrow-line {
    width: 24px;
    height: 2px;
    background-color: var(--color-cta);
    border-radius: var(--radius-full);
  }

  .faq-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .faq-lead {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-body);
    max-width: 48ch;
  }

  .faq-help-card {
    margin-top: var(--space-4);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background-color: var(--color-bg-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 48ch;
  }

  .help-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .help-icon {
    width: 20px;
    height: 20px;
    color: var(--color-cta);
    flex-shrink: 0;
  }

  .help-heading {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .help-copy {
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .help-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-2);
  }

  .help-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    background-color: var(--color-cta);
    color: var(--color-cta-contrast);
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .help-btn:hover {
    background-color: var(--color-cta-hover);
    transform: translateY(-1px);
  }

  .btn-icon {
    width: 14px;
    height: 14px;
  }

  .help-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-cyan-light);
    transition: color var(--transition-fast);
  }

  .help-link:hover {
    color: var(--color-text-main);
  }

  .link-arrow {
    width: 14px;
    height: 14px;
    transition: transform var(--transition-fast);
  }

  .help-link:hover .link-arrow {
    transform: translateX(3px);
  }

  /* ------------------------------------------------------------
     Right Column: Accordion
     ------------------------------------------------------------ */
  .faq-list-col {
    width: 100%;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background-color: var(--color-bg-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .faq-item:hover {
    border-color: var(--color-border-medium);
  }

  .faq-item[open] {
    border-color: var(--color-brand-border);
    background-color: var(--color-bg-surface-elevated);
  }

  .faq-summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
    padding: clamp(1.15rem, 2.5vw, 1.4rem) clamp(1.25rem, 3vw, 1.75rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    transition: background-color var(--transition-fast);
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .faq-summary:focus-visible {
    outline: none;
    box-shadow: var(--ring-focus);
    border-radius: var(--radius-md);
  }

  .faq-question-text {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.35;
  }

  .faq-icon-wrapper {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: transform var(--transition-normal), background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .faq-icon {
    width: 16px;
    height: 16px;
    color: var(--color-cta);
    transition: transform var(--transition-normal);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-item[open] .faq-icon-wrapper {
    background-color: var(--color-cta-tint);
    border-color: rgba(249, 115, 22, 0.35);
  }

  .faq-answer {
    padding: 0 clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 1.5rem);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    animation: faqSlideDown 200ms ease forwards;
  }

  .faq-answer p {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-text-body);
  }

  @keyframes faqSlideDown {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer {
      animation: none;
    }
    .faq-icon {
      transition: none;
    }
    .faq-icon-wrapper {
      transition: none;
    }
  }
</style>
