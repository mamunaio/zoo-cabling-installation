---
interface Pillar {
  title: string;
  description: string;
  icon: 'speed' | 'latency' | 'security';
}

const pillars: readonly Pillar[] = [
  {
    title: 'Speed & Bandwidth',
    description: 'Full gigabit performance throughout the premises instead of signal degradation through walls and distance.',
    icon: 'speed',
  },
  {
    title: 'Latency & Reliability',
    description: 'Significantly reduces wireless-related interference and latency instability for video calls and gaming, though it cannot prevent upstream ISP, router, or network equipment failures.',
    icon: 'latency',
  },
  {
    title: 'Physical Security',
    description: 'A direct, physical cabling path with zero over-the-air signal bleed or wireless radio interference.',
    icon: 'security',
  },
];
---

<section class="problem-section" aria-labelledby="problem-heading">
  <div class="container problem-container">
    <div class="problem-grid">
      <!-- Left Column: Copy & Three Pillars -->
      <div class="problem-content">
        <!-- Eyebrow -->
        <div class="problem-eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>The problem with wireless</span>
        </div>

        <!-- Section Heading -->
        <h2 id="problem-heading" class="problem-title">
          Wi-Fi isn’t always<br class="hidden-mobile" /> the answer.
        </h2>

        <!-- Context Copy -->
        <p class="problem-lead">
          Walls, distance and interference all work against wireless. Physical Cat6 connection removes those variables and gives each device a dedicated path to the router.
        </p>

        <!-- Three Pillars Grid -->
        <div class="pillars-grid">
          {pillars.map((pillar) => (
            <div class="pillar-card">
              <div class="pillar-indicator" aria-hidden="true"></div>
              <div class="pillar-body">
                <h3 class="pillar-title">{pillar.title}</h3>
                <p class="pillar-desc">{pillar.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Authentic Infrastructure Photo -->
      <div class="problem-media">
        <div class="media-frame">
          <img
            src="/images/problem-cabling.jpg"
            alt="Ethernet patch cables cleanly terminated into a network switch"
            class="media-img"
            loading="lazy"
            decoding="async"
          />
          <div class="media-gradient" aria-hidden="true"></div>
          <div class="media-badge">
            <span class="badge-dot" aria-hidden="true"></span>
            <span>Dedicated Structured Cabling</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .problem-section {
    padding-block: var(--section-padding-y);
    background-color: var(--color-bg-base);
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .problem-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  /* ------------------------------------------------------------
     Left Column: Content & Eyebrow
     ------------------------------------------------------------ */
  .problem-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .problem-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-cta);
  }

  .eyebrow-line {
    width: 24px;
    height: 2px;
    background-color: var(--color-cta);
    border-radius: var(--radius-full);
  }

  .problem-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .hidden-mobile {
    display: none;
  }

  @media (min-width: 640px) {
    .hidden-mobile {
      display: inline;
    }
  }

  .problem-lead {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-body);
    max-width: 54ch;
  }

  /* ------------------------------------------------------------
     Three Pillars Layout
     ------------------------------------------------------------ */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  @media (min-width: 640px) {
    .pillars-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
  }

  .pillar-card {
    display: flex;
    position: relative;
    padding-left: var(--space-4);
    transition: transform var(--transition-fast);
  }

  .pillar-indicator {
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 3px;
    background: linear-gradient(to bottom, var(--color-cta), rgba(249, 115, 22, 0.2));
    border-radius: var(--radius-full);
    transition: background var(--transition-fast), width var(--transition-fast);
  }

  .pillar-card:hover .pillar-indicator {
    background: var(--color-cta);
    width: 4px;
  }

  .pillar-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pillar-title {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.3;
  }

  .pillar-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  /* ------------------------------------------------------------
     Right Column: Media Frame
     ------------------------------------------------------------ */
  .problem-media {
    width: 100%;
  }

  .media-frame {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid rgba(14, 165, 233, 0.22);
    box-shadow:
      0 20px 40px -12px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(14, 165, 233, 0.18),
      0 0 28px -4px rgba(14, 165, 233, 0.22),
      0 0 56px -8px rgba(37, 99, 235, 0.16),
      0 12px 36px -8px rgba(249, 115, 22, 0.11);
    background-color: var(--color-bg-surface);
    aspect-ratio: 4 / 3;
    min-height: 280px;
    transition: box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .media-frame:hover {
    border-color: rgba(14, 165, 233, 0.35);
    box-shadow:
      0 24px 48px -12px rgba(0, 0, 0, 0.75),
      0 0 0 1px rgba(14, 165, 233, 0.26),
      0 0 36px -2px rgba(14, 165, 233, 0.28),
      0 0 68px -6px rgba(37, 99, 235, 0.2),
      0 14px 42px -6px rgba(249, 115, 22, 0.15);
  }

  @media (min-width: 1024px) {
    .media-frame {
      aspect-ratio: 1 / 1;
      max-height: 480px;
    }
  }

  .media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .media-frame:hover .media-img {
    transform: scale(1.03);
  }

  .media-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 15, 29, 0.85) 0%,
      rgba(10, 15, 29, 0.2) 50%,
      transparent 100%
    );
    pointer-events: none;
  }

  .media-badge {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    background: rgba(10, 15, 29, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--color-border-medium);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-main);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--color-success);
    box-shadow: 0 0 6px var(--color-success);
  }
</style>
