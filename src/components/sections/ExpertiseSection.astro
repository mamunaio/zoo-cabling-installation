---
import { business } from '../../config/business';

const credentialTags = [
  'ACMA Licensed',
  'Structured Cat6/Cat6A',
  'Fibre Endorsed',
  'ACRS Master Cabler Certified',
] as const;
---

<section class="expertise-section" id="expertise" aria-labelledby="expertise-heading">
  <div class="container expertise-container">
    <!-- Top Block: Data Electrician vs Specialist & ACRS Master Cabler Badge -->
    <div class="expertise-grid">
      <div class="expertise-copy">
        <div class="expertise-eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>Data cabling expertise</span>
        </div>

        <h2 id="expertise-heading" class="expertise-title">
          Looking for a data electrician?
        </h2>

        <p class="expertise-lead">
          While many traditional electricians handle general power, data wiring requires specialised telecommunications expertise. We are fully ACMA licensed data cablers and network specialists dedicated exclusively to optimizing your NBN, Ethernet, and structured cabling infrastructure.
        </p>

        <!-- Credentials Pills -->
        <div class="credentials-pills">
          {credentialTags.map((tag) => (
            <span class="credential-pill">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="pill-check" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{tag}</span>
            </span>
          ))}
        </div>
      </div>

      <!-- Credential Verification Card -->
      <div class="credential-media">
        <div class="badge-card">
          <img
            src="/assets/data-cabling-installation/acrs-master-cabler.webp"
            alt="ACRS Master Cabler certified credential logo"
            class="badge-img"
            loading="lazy"
            decoding="async"
          />
          <div class="badge-caption">
            <span class="status-indicator" aria-hidden="true"></span>
            <span>Accredited Telecommunications Cabler</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Block: Richard's Specialist Profile Card -->
    <div class="specialist-showcase">
      <div class="specialist-card">
        <div class="specialist-grid">
          <!-- Richard Portrait Photo -->
          <div class="specialist-photo-col">
            <div class="photo-wrapper">
              <img
                src="/assets/data-cabling-installation/Richard.webp"
                alt="Richard, data cabling specialist at Zoo Computer Repairs"
                class="specialist-img"
                loading="lazy"
                decoding="async"
              />
              <div class="photo-glow" aria-hidden="true"></div>
            </div>
          </div>

          <!-- Richard's Personal Quote & Commitment -->
          <div class="specialist-bio-col">
            <div class="specialist-kicker">
              <span class="kicker-badge">Direct Technician Access</span>
              <span class="specialist-title">Lead Cabling Specialist</span>
            </div>

            <h3 class="specialist-name">Meet Richard</h3>

            <blockquote class="specialist-quote">
              <p>
                "Hey I'm Richard. When you fill in the above form, I'll be the one calling you back directly. A fast, reliable network isn't just about running a cable from A to B — every Cat6 run has to be planned, terminated and tested to actually deliver full gigabit speed to the room it serves.
              </p>
              <p>
                I don't just pull cable; I map out your NBN entry point, plan your rack and patch panel layout, and test every single jack with a certified tester before I leave so your ethernet performs exactly as it should. Reach out today, and I will personally call you back to design a rock-solid wired network for your property."
              </p>
            </blockquote>

            <div class="specialist-actions">
              <a href="#quote" class="btn-specialist-quote">
                <span>Request Callback From Richard</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="btn-icon" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>

              <a href={`tel:${business.phoneTel}`} class="btn-specialist-call" aria-label={`Call ${business.phone}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="btn-icon" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <span>Call {business.phone}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .expertise-section {
    padding-block: var(--section-padding-y);
    background-color: var(--color-bg-base);
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  /* ------------------------------------------------------------
     Part 1: Data Electrician Grid
     ------------------------------------------------------------ */
  .expertise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  @media (min-width: 1024px) {
    .expertise-grid {
      grid-template-columns: 1.35fr 0.85fr;
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  .expertise-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .expertise-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-cta);
  }

  .eyebrow-line {
    width: 24px;
    height: 2px;
    background-color: var(--color-cta);
    border-radius: var(--radius-full);
  }

  .expertise-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .expertise-lead {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-body);
    max-width: 60ch;
  }

  /* Credentials Pills */
  .credentials-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .credential-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-main);
    letter-spacing: 0.02em;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .pill-check {
    width: 14px;
    height: 14px;
    color: var(--color-cta);
    flex-shrink: 0;
  }

  /* Badge Media Card */
  .credential-media {
    width: 100%;
  }

  .badge-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .badge-img {
    max-width: 280px;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .badge-caption {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .status-indicator {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background-color: var(--color-success);
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
  }

  /* ------------------------------------------------------------
     Part 2: Richard's Specialist Showcase
     ------------------------------------------------------------ */
  .specialist-showcase {
    position: relative;
  }

  .specialist-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-card), 0 12px 32px -8px rgba(15, 23, 42, 0.06);
  }

  .specialist-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 860px) {
    .specialist-grid {
      grid-template-columns: 0.75fr 1.25fr;
    }
  }

  /* Photo Column */
  .specialist-photo-col {
    position: relative;
    background: radial-gradient(circle at center, rgba(37, 99, 235, 0.08) 0%, #f8fafc 100%);
    display: flex;
    justify-content: center;
    align-items: flex-end;
    overflow: hidden;
    padding-top: var(--space-6);
  }

  .photo-wrapper {
    position: relative;
    width: 100%;
    max-width: 320px;
  }

  .specialist-img {
    width: 100%;
    height: auto;
    max-height: 440px;
    object-fit: contain;
    object-position: bottom;
    display: block;
    position: relative;
    z-index: 2;
  }

  /* Bio Column */
  .specialist-bio-col {
    padding: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .specialist-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .kicker-badge {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    background: var(--color-cta-tint);
    border: 1px solid rgba(249, 115, 22, 0.35);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-cta);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .specialist-title {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .specialist-name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text-main);
    line-height: 1.2;
  }

  .specialist-quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-text-body);
    border-left: 3px solid var(--color-brand);
    padding-left: var(--space-4);
  }

  /* Actions */
  .specialist-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .btn-specialist-quote {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1.4rem;
    background-color: var(--color-cta);
    color: var(--color-cta-contrast);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 14px rgba(249, 115, 22, 0.35);
  }

  .btn-specialist-quote:hover {
    background-color: var(--color-cta-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(249, 115, 22, 0.45);
  }

  .btn-specialist-call {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1.2rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .btn-specialist-call:hover {
    border-color: var(--color-brand);
    background: var(--color-brand-tint);
    color: var(--color-brand);
  }

  .btn-icon {
    width: 16px;
    height: 16px;
  }

  .btn-specialist-quote:hover .btn-icon {
    transform: translateX(2px);
  }
</style>
