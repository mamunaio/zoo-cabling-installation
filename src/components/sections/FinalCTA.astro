---
import { business } from '../../config/business';

interface Props {
  id?: string;
}

const { id = 'final-cta' } = Astro.props;
---

<section class="final-cta-section" id={id} aria-labelledby="final-cta-heading">
  <div class="container final-cta-container">
    <div class="cta-card">
      <!-- Genuine Cabling Background Overlay -->
      <div class="cta-bg" aria-hidden="true">
        <img
          src="/images/hero-cabling-v3.jpg"
          alt=""
          class="cta-bg-img"
          loading="lazy"
          decoding="async"
        />
        <div class="cta-overlay"></div>
      </div>

      <!-- Content -->
      <div class="cta-content">
        <!-- Eyebrow -->
        <div class="cta-eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>Fast, Reliable Wired Connectivity</span>
        </div>

        <!-- Heading -->
        <h2 id="final-cta-heading" class="cta-title">
          Get your home or office hardwired today.
        </h2>

        <!-- Supporting text -->
        <p class="cta-lead">
          Eliminate Wi-Fi dropouts and lag with dedicated Cat6 and Cat6A structured cabling. Speak directly with Richard for upfront advice and prompt Brisbane-wide installation.
        </p>

        <!-- CTA Actions -->
        <div class="cta-actions">
          <a href="#quote" class="btn-cta-primary">
            <span>Free Quote</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a href={`tel:${business.phoneTel}`} class="btn-cta-secondary" aria-label={`Call Richard on ${business.phone}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="btn-phone" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>Call {business.phone}</span>
          </a>
        </div>

        <!-- Service Area Link -->
        <div class="cta-service-area">
          <svg class="pin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span class="service-text">
            Servicing {business.serviceArea} &bull;
            <a
              href="https://www.zoorepairs.com.au/suburbs-that-we-service/"
              target="_blank"
              rel="noopener noreferrer"
              class="suburbs-link"
            >
              <span>View suburbs that we service</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="link-external" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    padding-block: var(--section-padding-y);
    background-color: var(--color-bg-base);
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  .cta-card {
    position: relative;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(29, 78, 216, 0.15);
    background: linear-gradient(135deg, #ffffff 0%, #eff6ff 100%);
    box-shadow: var(--shadow-lg), 0 10px 40px -15px rgba(29, 78, 216, 0.12);
    overflow: hidden;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 5vw, 3.5rem);
    text-align: center;
  }

  /* ------------------------------------------------------------
     Genuine Local Cabling Image Subtle Overlay
     ------------------------------------------------------------ */
  .cta-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .cta-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.08;
    filter: saturate(1.1);
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.95) 100%);
  }

  /* ------------------------------------------------------------
     Content Layout
     ------------------------------------------------------------ */
  .cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 720px;
    margin-inline: auto;
  }

  .cta-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-cta);
    margin-bottom: var(--space-3);
  }

  .eyebrow-line {
    width: 24px;
    height: 2px;
    background-color: var(--color-cta);
    border-radius: var(--radius-full);
  }

  .cta-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--color-text-main);
    margin-bottom: var(--space-4);
    text-wrap: balance;
  }

  .cta-lead {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-body);
    max-width: 58ch;
    margin-bottom: var(--space-8);
  }

  /* ------------------------------------------------------------
     CTA Action Buttons
     ------------------------------------------------------------ */
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-bottom: var(--space-6);
    width: 100%;
  }

  .btn-cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem 2rem;
    background-color: var(--color-cta);
    color: var(--color-cta-contrast);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: var(--shadow-md);
    text-decoration: none;
    min-height: 48px;
  }

  .btn-cta-primary:hover {
    background-color: var(--color-cta-hover);
    box-shadow: var(--color-cta-glow);
    transform: translateY(-2px);
  }

  .btn-arrow {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }

  .btn-cta-primary:hover .btn-arrow {
    transform: translateX(3px);
  }

  .btn-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem 1.75rem;
    background-color: #ffffff;
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast), color var(--transition-fast);
    text-decoration: none;
    min-height: 48px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .btn-cta-secondary:hover {
    background-color: var(--color-brand-tint);
    border-color: var(--color-brand);
    color: var(--color-brand);
    transform: translateY(-2px);
  }

  .btn-phone {
    width: 18px;
    height: 18px;
    color: var(--color-brand);
  }

  /* ------------------------------------------------------------
     Service Area & Suburbs Link
     ------------------------------------------------------------ */
  .cta-service-area {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-full);
    max-width: 100%;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .pin-icon {
    width: 15px;
    height: 15px;
    color: var(--color-cta);
    flex-shrink: 0;
  }

  .service-text {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .suburbs-link {
    color: var(--color-brand);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: color var(--transition-fast);
  }

  .suburbs-link:hover {
    color: var(--color-brand-hover);
    text-decoration: underline;
  }

  .link-external {
    width: 12px;
    height: 12px;
  }

  /* ------------------------------------------------------------
     Mobile Refinements
     ------------------------------------------------------------ */
  @media (max-width: 640px) {
    .cta-actions {
      flex-direction: column;
      gap: 0.75rem;
    }

    .btn-cta-primary,
    .btn-cta-secondary {
      width: 100%;
      max-width: 320px;
    }

    .cta-service-area {
      border-radius: var(--radius-md);
      padding: 0.75rem 1rem;
      text-align: center;
    }

    .service-text {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-cta-primary:hover,
    .btn-cta-secondary:hover {
      transform: none;
    }

    .btn-cta-primary:hover .btn-arrow {
      transform: none;
    }
  }
</style>
