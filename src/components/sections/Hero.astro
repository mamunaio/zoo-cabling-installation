---
import { business } from '../../config/business';
import QuoteForm from '../ui/QuoteForm.astro';
---

<section class="hero-section" aria-label="Hero Section">
  <!-- Genuine Legacy Hero Background Image -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/images/hero-cabling-v3.jpg"
      alt=""
      class="hero-bg-img"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-grid">
      <!-- Left Column: Verified Copy & Actions -->
      <div class="hero-copy">
        <!-- Eyebrow Badge -->
        <div class="hero-eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>ACMA Registered Cablers &amp; Network Specialists</span>
        </div>

        <!-- Main H1 Heading -->
        <h1 class="hero-title">
          <span class="hero-title-lead">Residential &amp; Commercial</span>
          <span class="hero-title-accent">Data and Ethernet Installation</span>
          <span class="hero-title-tail">for fast, lag-free connections.</span>
        </h1>

        <!-- Supporting Copy -->
        <p class="hero-lead">
          Eliminate Wi-Fi dropouts with professional Cat6 and Cat6A data cabling for homes, offices, gaming setups, smart TVs and security cameras across Brisbane.
        </p>

        <!-- Call to Actions -->
        <div class="hero-actions">
          <a href="#quote" class="btn-hero-primary">
            <span>Get an Instant Per-Point Estimate</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="icon-arrow" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a href={`tel:${business.phoneTel}`} class="btn-hero-secondary" aria-label={`Call ${business.phone}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="icon-phone" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>Call {business.phone}</span>
          </a>
        </div>

        <!-- Trust Highlights Strip -->
        <div class="hero-trust-strip">
          <div class="trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="trust-icon" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Full Gigabit &amp; 10G Tested</span>
          </div>
          <div class="trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="trust-icon" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Concealed Wall Cavity Feeds</span>
          </div>
          <div class="trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="trust-icon" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Lifetime Workmanship Warranty</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Quote Form -->
      <div class="hero-form-col">
        <QuoteForm id="quote" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
    overflow: hidden;
    background-color: var(--color-bg-base);
  }

  /* ------------------------------------------------------------
     Genuine Legacy Hero Background Image & Gradient Overlay
     ------------------------------------------------------------ */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.22;
    filter: saturate(1.1);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 80% 20%, rgba(37, 99, 235, 0.12) 0%, transparent 60%),
      linear-gradient(to bottom, rgba(10, 15, 29, 0.75) 0%, rgba(10, 15, 29, 0.95) 75%, var(--color-bg-base) 100%),
      linear-gradient(to right, rgba(10, 15, 29, 0.95) 0%, rgba(10, 15, 29, 0.8) 50%, rgba(10, 15, 29, 0.95) 100%);
  }

  /* ------------------------------------------------------------
     Hero Container & Two-Column Grid
     ------------------------------------------------------------ */
  .hero-container {
    position: relative;
    z-index: 10;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.12fr 0.88fr;
    }
  }

  /* Copy Column */
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Eyebrow Badge */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    padding: 0.4rem 0.85rem;
    background: var(--color-brand-tint);
    border: 1px solid var(--color-brand-border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-cyan-light);
    letter-spacing: 0.02em;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--color-cta);
    box-shadow: 0 0 6px var(--color-cta);
  }

  /* Main Title */
  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 800;
  }

  .hero-title-lead {
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero-title-accent {
    color: var(--color-cta);
    background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-title-tail {
    color: var(--color-text-main);
  }

  /* Lead text */
  .hero-lead {
    font-size: var(--text-base);
    color: var(--color-text-body);
    line-height: 1.65;
    max-width: 58ch;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    background-color: var(--color-cta);
    color: var(--color-cta-contrast);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
    box-shadow: 0 4px 18px rgba(249, 115, 22, 0.35);
    text-align: center;
  }

  .btn-hero-primary:hover {
    background-color: var(--color-cta-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(249, 115, 22, 0.45);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-main);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    transition: all var(--transition-fast);
  }

  .btn-hero-secondary:hover {
    border-color: var(--color-brand-border);
    background: var(--color-brand-tint);
    color: var(--color-accent-cyan-light);
  }

  .icon-arrow,
  .icon-phone {
    width: 17px;
    height: 17px;
  }

  .btn-hero-primary:hover .icon-arrow {
    transform: translateX(2px);
  }

  /* Trust Strip */
  .hero-trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-2);
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .trust-icon {
    width: 15px;
    height: 15px;
    color: var(--color-success);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-hero-primary,
    .btn-hero-secondary {
      width: 100%;
    }
  }
</style>
