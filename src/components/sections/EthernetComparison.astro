---
interface ComparisonItem {
  id: string;
  dimension: string;
  wiredTitle: string;
  wiredDetail: string;
  wifiTitle: string;
  wifiDetail: string;
}

const comparisonData: readonly ComparisonItem[] = [
  {
    id: 'speed',
    dimension: 'Speed & Bandwidth',
    wiredTitle: 'High Throughput Copper Run',
    wiredDetail: 'Dedicated Cat6/Cat6A link maintains high throughput without attenuation through interior walls or ceiling structures.',
    wifiTitle: 'Signal Attenuation with Distance',
    wifiDetail: 'Throughput degrades rapidly through double-brick, insulation, and building obstacles.',
  },
  {
    id: 'latency',
    dimension: 'Latency & Ping Stability',
    wiredTitle: 'Minimal, Predictable Ping',
    wiredDetail: 'Delivers highly stable local packet delivery, removing the jitter and ping spikes common over radio frequencies.',
    wifiTitle: 'Variable Channel Contention',
    wifiDetail: 'Subject to packet queuing, radio retransmissions, and latency fluctuations when multiple devices communicate.',
  },
  {
    id: 'reliability',
    dimension: 'Connection Reliability',
    wiredTitle: 'Dedicated Physical Medium',
    wiredDetail: 'Direct cable run unaffected by appliance interference, microwave bleed, or neighborhood channel congestion.',
    wifiTitle: 'Prone to Dead Zones & Drops',
    wifiDetail: 'Susceptible to dead zones, RF interference, and occasional signal drops during critical meetings or streams.',
  },
  {
    id: 'security',
    dimension: 'Physical Network Security',
    wiredTitle: 'Contained to Premises',
    wiredDetail: 'Data stays inside shielded in-wall cabling with no broadcast footprint outside your home or office building.',
    wifiTitle: 'Over-the-Air RF Broadcast',
    wifiDetail: 'Wireless radio waves radiate through exterior walls, requiring ongoing encryption updates to guard against eavesdropping.',
  },
];
---

<section class="comparison-section" id="comparison" aria-labelledby="comparison-heading">
  <div class="container comparison-container">
    <!-- Section Header -->
    <div class="section-header">
      <div class="comparison-eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span>Head to Head</span>
      </div>
      <h2 id="comparison-heading" class="comparison-title">
        Why hardwired ethernet beats Wi-Fi.
      </h2>
      <p class="comparison-lead">
        While Wi-Fi offers casual mobility, hardwired Cat6 structured cabling delivers the physical consistency required for mission-critical workstations, media servers, and continuous-recording security systems.
      </p>
    </div>

    <!-- Desktop Comparison Table (Visible >= 768px) -->
    <div class="table-wrapper desktop-only">
      <table class="comparison-table">
        <caption class="sr-only">
          Head-to-head comparison of hardwired Ethernet versus Wi-Fi across speed, latency, reliability, and security
        </caption>
        <thead>
          <tr>
            <th scope="col" class="col-feature">Dimension</th>
            <th scope="col" class="col-wired">
              <div class="th-brand">
                <span class="badge-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="icon-th">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>Hardwired Ethernet (Cat6)</span>
              </div>
            </th>
            <th scope="col" class="col-wifi">
              <div class="th-wifi">
                <span class="badge-icon-wifi" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-th">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
                <span>Standard Wi-Fi</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          {comparisonData.map((row, index) => (
            <tr>
              <th scope="row" class="row-dimension">
                <span class="dimension-index" aria-hidden="true">0{index + 1}</span>
                <span class="dimension-name">{row.dimension}</span>
              </th>
              <td class="cell-wired">
                <div class="cell-content">
                  <strong class="cell-highlight">{row.wiredTitle}</strong>
                  <p class="cell-desc">{row.wiredDetail}</p>
                </div>
              </td>
              <td class="cell-wifi">
                <div class="cell-content">
                  <strong class="cell-sub">{row.wifiTitle}</strong>
                  <p class="cell-desc">{row.wifiDetail}</p>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile Comparison Cards (Visible < 768px) -->
    <div class="mobile-cards-list mobile-only">
      {comparisonData.map((row, index) => (
        <div class="mobile-card">
          <div class="mobile-card-header">
            <span class="mobile-index" aria-hidden="true">0{index + 1}</span>
            <h3 class="mobile-dimension">{row.dimension}</h3>
          </div>

          <div class="mobile-blocks">
            <!-- Hardwired Block -->
            <div class="mobile-block block-wired">
              <div class="block-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="block-icon wired-icon" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Hardwired Cat6</span>
              </div>
              <strong class="block-title">{row.wiredTitle}</strong>
              <p class="block-desc">{row.wiredDetail}</p>
            </div>

            <!-- Wi-Fi Block -->
            <div class="mobile-block block-wifi">
              <div class="block-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="block-icon wifi-icon" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Standard Wi-Fi</span>
              </div>
              <strong class="block-title">{row.wifiTitle}</strong>
              <p class="block-desc">{row.wifiDetail}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Disclaimer / Technical Transparency Note -->
    <div class="technical-disclaimer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="disclaimer-icon" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <p>
        <strong>Technical note:</strong> Actual network throughput and ping times depend on connected equipment (router, switches, network interface cards), cabling grade (Cat6 vs Cat6A), ISP speeds, and local network configuration. Physical cabling ensures maximum medium stability and eliminates wireless radio interference.
      </p>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    padding-block: var(--section-padding-y);
    background-color: var(--color-bg-base);
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  /* ------------------------------------------------------------
     Header
     ------------------------------------------------------------ */
  .section-header {
    max-width: 680px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .comparison-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-cta);
  }

  .eyebrow-line {
    width: 24px;
    height: 2px;
    background-color: var(--color-cta);
    border-radius: var(--radius-full);
  }

  .comparison-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .comparison-lead {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text-body);
  }

  /* ------------------------------------------------------------
     Desktop Comparison Table
     ------------------------------------------------------------ */
  .desktop-only {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-only {
      display: block;
    }
  }

  .table-wrapper {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  thead {
    background: rgba(10, 15, 29, 0.6);
    border-bottom: 1px solid var(--color-border-medium);
  }

  th, td {
    padding: clamp(1rem, 2vw, 1.5rem);
    vertical-align: top;
  }

  .col-feature {
    width: 26%;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-faint);
  }

  .col-wired {
    width: 37%;
    background: rgba(37, 99, 235, 0.04);
    border-left: 1px solid var(--color-border-medium);
    border-right: 1px solid var(--color-border-medium);
  }

  .col-wifi {
    width: 37%;
  }

  .th-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-cta);
  }

  .th-wifi {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-full);
    background: rgba(249, 115, 22, 0.15);
    color: var(--color-cta);
  }

  .badge-icon-wifi {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-faint);
  }

  .icon-th {
    width: 14px;
    height: 14px;
  }

  tbody tr {
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-fast);
  }

  tbody tr:last-child {
    border-bottom: none;
  }

  tbody tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .row-dimension {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .dimension-index {
    color: var(--color-cta);
    font-size: var(--text-xs);
    margin-top: 2px;
    font-weight: 600;
  }

  .dimension-name {
    line-height: 1.3;
  }

  .cell-wired {
    background: rgba(37, 99, 235, 0.03);
    border-left: 1px solid var(--color-border-medium);
    border-right: 1px solid var(--color-border-medium);
  }

  .cell-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cell-highlight {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .cell-sub {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-body);
  }

  .cell-desc {
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* ------------------------------------------------------------
     Mobile Cards List (Visible < 768px)
     ------------------------------------------------------------ */
  .mobile-only {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-only {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
  }

  .mobile-card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-index {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-cta);
  }

  .mobile-dimension {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .mobile-blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--space-3);
    border-radius: var(--radius-sm);
  }

  .block-wired {
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid var(--color-brand-border);
  }

  .block-wifi {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
  }

  .block-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .block-wired .block-label {
    color: var(--color-cta);
  }

  .block-wifi .block-label {
    color: var(--color-text-muted);
  }

  .block-icon {
    width: 13px;
    height: 13px;
  }

  .block-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: 0.15rem;
  }

  .block-desc {
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  /* ------------------------------------------------------------
     Technical Disclaimer Banner
     ------------------------------------------------------------ */
  .technical-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding: var(--space-4);
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .disclaimer-icon {
    width: 18px;
    height: 18px;
    color: var(--color-accent-cyan-light);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .technical-disclaimer strong {
    color: var(--color-text-body);
  }
</style>
