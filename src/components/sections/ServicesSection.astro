---
interface ServiceItem {
  id: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  icon: 'office' | 'gaming' | 'streaming' | 'cctv' | 'commercial' | 'wifi';
  badge: string;
}

const services: readonly ServiceItem[] = [
  {
    id: 'home-office',
    title: 'Home Office & Remote Work',
    description: 'Stable video calls and high-bandwidth file transfers with dedicated Cat6 wall plates positioned right at your desk.',
    image: '/images/service-home-office.jpg',
    imageAlt: 'Home office workstation equipped with dual monitors and dedicated wall-plate network connections',
    icon: 'office',
    badge: 'Cat6 Wall Plates',
  },
  {
    id: 'gaming',
    title: 'Low-Latency Gaming Rooms',
    description: 'Direct Ethernet drops to your gaming PC or console, removing wireless interference and erratic ping spikes.',
    image: '/images/service-gaming.jpg',
    imageAlt: 'Modern gaming setup with desktop PC and peripherals connected via hardwired ethernet',
    icon: 'gaming',
    badge: 'Direct Ethernet',
  },
  {
    id: 'streaming',
    title: '4K/8K Smart TV Streaming',
    description: 'High-bandwidth wired connections for Smart TVs, Apple TV, and media servers to minimize streaming buffering.',
    image: '/images/service-streaming.jpg',
    imageAlt: 'Wall-mounted 4K smart television connected for media streaming',
    icon: 'streaming',
    badge: 'High Bandwidth',
  },
  {
    id: 'security',
    title: 'PoE Security Camera Cabling',
    description: 'Concealed in-wall Power-over-Ethernet (PoE) runs delivering reliable data and power to continuous-recording cameras.',
    image: '/images/service-security.jpg',
    imageAlt: 'Outdoor PoE security camera mounted with weatherproof structured cabling',
    icon: 'cctv',
    badge: 'PoE Cat6 Runs',
  },
  {
    id: 'commercial',
    title: 'Business & Office Fit-Outs',
    description: 'Commercial structured data cabling for workstations, conference rooms, patch panels, and server equipment racks.',
    image: '/images/service-office-fitout.jpg',
    imageAlt: 'Commercial office fitout with structured network drops and organized workspace cabling',
    icon: 'commercial',
    badge: 'Structured Racks',
  },
  {
    id: 'wifi-backhaul',
    title: 'Wi-Fi Access Point Backhauling',
    description: 'Hardwire your UniFi, TP-Link Omada, or mesh nodes with dedicated Ethernet backhaul for optimal wireless coverage.',
    image: '/images/service-wifi-backhaul.jpg',
    imageAlt: 'Ceiling mounted wireless access point backed by in-ceiling Cat6 cable run',
    icon: 'wifi',
    badge: 'Mesh / UniFi APs',
  },
];
---

<section class="services-section" id="services" aria-labelledby="services-heading">
  <div class="container services-container">
    <!-- Section Header -->
    <div class="section-header">
      <div class="services-eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span>What We Install</span>
      </div>
      <h2 id="services-heading" class="services-title">
        Structured cabling for every part of the home and office.
      </h2>
      <p class="services-lead">
        Tailored Cat6 and Cat6A data installations engineered for long-term reliability, clean concealment, and verified data throughput.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="services-grid">
      {services.map((item) => (
        <article class="service-card" id={`service-${item.id}`}>
          <!-- Card Image Container -->
          <div class="card-media">
            <img
              src={item.image}
              alt={item.imageAlt}
              class="card-img"
              width="1672"
              height="941"
              loading="lazy"
              decoding="async"
            />
            <div class="card-media-overlay" aria-hidden="true"></div>
            <span class="card-badge">{item.badge}</span>
          </div>

          <!-- Card Content -->
          <div class="card-content">
            <div class="card-header">
              <div class="card-icon-wrapper" aria-hidden="true">
                {item.icon === 'office' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                  </svg>
                )}
                {item.icon === 'gaming' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon">
                    <line x1="6" y1="12" x2="10" y2="12"></line>
                    <line x1="8" y1="10" x2="8" y2="14"></line>
                    <line x1="15" y1="13" x2="15.01" y2="13"></line>
                    <line x1="18" y1="11" x2="18.01" y2="11"></line>
                    <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                  </svg>
                )}
                {item.icon === 'streaming' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon">
                    <rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect>
                    <polyline points="17 2 12 7 7 2"></polyline>
                  </svg>
                )}
                {item.icon === 'cctv' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                    <circle cx="12" cy="13" r="4"></circle>
                  </svg>
                )}
                {item.icon === 'commercial' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon">
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                    <line x1="6" y1="6" x2="6.01" y2="6"></line>
                    <line x1="6" y1="18" x2="6.01" y2="18"></line>
                  </svg>
                )}
                {item.icon === 'wifi' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon">
                    <rect x="2" y="14" width="20" height="8" rx="2"></rect>
                    <path d="M6.01 18H6"></path>
                    <path d="M10.01 18H10"></path>
                    <path d="M15 10v4"></path>
                    <path d="M17.84 7.17a4 4 0 0 0-5.66 0"></path>
                    <path d="M20.66 4.34a8 8 0 0 0-11.31 0"></path>
                  </svg>
                )}
              </div>
              <h3 class="card-title">{item.title}</h3>
            </div>
            <p class="card-description">{item.description}</p>
            <div class="card-action">
              <a href="#quote" data-service={item.title} class="card-link" aria-label={`Get estimate for ${item.title}`}>
                <span>Request Estimate</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="card-arrow" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding-block: var(--section-padding-y);
    background-color: var(--color-bg-base);
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  /* ------------------------------------------------------------
     Header
     ------------------------------------------------------------ */
  .section-header {
    max-width: 680px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .services-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-cta);
  }

  .eyebrow-line {
    width: 24px;
    height: 2px;
    background-color: var(--color-cta);
    border-radius: var(--radius-full);
  }

  .services-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .services-lead {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text-body);
  }

  /* ------------------------------------------------------------
     Responsive Grid Layout
     ------------------------------------------------------------ */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ------------------------------------------------------------
     Service Cards
     ------------------------------------------------------------ */
  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: var(--shadow-card);
  }

  .service-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-brand-border);
    box-shadow: 0 12px 30px -6px rgba(0, 0, 0, 0.5), 0 0 1px 1px var(--color-brand-border);
  }

  /* Media Frame */
  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-surface-raised);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
  }

  .service-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(16, 23, 42, 0.85) 0%, rgba(16, 23, 42, 0.15) 50%, transparent 100%);
    pointer-events: none;
  }

  .card-badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: 0.25rem 0.65rem;
    background: rgba(10, 15, 29, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--color-border-medium);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent-cyan-light);
    letter-spacing: 0.02em;
  }

  /* Card Content */
  .card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5);
    gap: var(--space-3);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-brand-tint);
    border: 1px solid var(--color-brand-border);
    color: var(--color-accent-cyan-light);
    flex-shrink: 0;
  }

  .card-icon {
    width: 18px;
    height: 18px;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.25;
  }

  .card-description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .card-action {
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-cyan-light);
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .card-link:hover {
    color: var(--color-cta);
  }

  .card-arrow {
    width: 14px;
    height: 14px;
    transition: transform var(--transition-fast);
  }

  .card-link:hover .card-arrow {
    transform: translateX(3px);
  }
</style>
