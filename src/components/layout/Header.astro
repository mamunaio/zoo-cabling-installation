---
import { business } from '../../config/business';

interface NavLink {
  label: string;
  href: string;
}

const navLinks: readonly NavLink[] = [
  { label: 'About Us', href: 'https://www.zoorepairs.com.au/about-us/' },
  { label: 'Computer Services', href: 'https://www.zoorepairs.com.au/computer-services/' },
  { label: 'Remote', href: 'https://www.zoorepairs.com.au/remote/' },
  { label: 'Reviews', href: 'https://www.zoorepairs.com.au/reviews/' },
  { label: 'Blog', href: 'https://www.zoorepairs.com.au/blog/' },
  { label: 'Contact', href: 'https://www.zoorepairs.com.au/contact/' },
];
---

<div class="header-wrapper">
  <!-- Top Dispatch & Compliance Bar -->
  <aside class="compliance-bar" aria-label="Licensing and dispatch notice">
    <div class="container compliance-container">
      <div class="compliance-badge">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="compliance-title">ACMA Registered Cablers</span>
        <span class="compliance-sep" aria-hidden="true">•</span>
        <span class="compliance-sub">Cat6 &amp; Cat6A Specialists</span>
      </div>

      <div class="compliance-meta">
        <span class="compliance-area">{business.serviceArea}</span>
        <span class="compliance-sep" aria-hidden="true">•</span>
        <a href={`tel:${business.phoneTel}`} class="compliance-phone" aria-label={`Call ${business.phone}`}>
          <svg class="icon-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>{business.phone}</span>
        </a>
      </div>
    </div>
  </aside>

  <!-- Main Sticky Header -->
  <header class="site-header" id="site-header">
    <div class="container header-container">
      <!-- Brand Logo / Identity -->
      <a href="/" class="brand" aria-label="Zoo Computer Repairs — Data & Ethernet Cabling">
        <img
          src="/assets/data-cabling-installation/zoologo.webp"
          alt="Zoo Computer Repairs — Data & Ethernet Cabling"
          class="brand-logo"
          width="400"
          height="118"
          loading="eager"
          decoding="async"
        />
        <span class="brand-divider" aria-hidden="true"></span>
        <span class="brand-subtitle" aria-hidden="true">Cabling &amp; Ethernet</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          {navLinks.map((item) => (
            <li class="nav-item">
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Header Actions -->
      <div class="header-actions">
        <a href={`tel:${business.phoneTel}`} class="btn-phone" aria-label={`Call ${business.phone}`}>
          <svg class="icon-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span class="phone-number">{business.phone}</span>
        </a>

        <a href={business.quoteUrl} class="btn-quote" target="_blank" rel="noopener noreferrer">
          <span>Get a Quote</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="icon-arrow" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          class="mobile-toggle"
          id="mobile-nav-toggle"
          aria-label="Open mobile navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
        >
          <span class="hamburger-box" aria-hidden="true">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </span>
        </button>
      </div>
    </div>
  </header>
</div>

<style>
  .header-wrapper {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
  }

  /* ------------------------------------------------------------
     Top Compliance / Announcement Bar
     ------------------------------------------------------------ */
  .compliance-bar {
    background: var(--color-bg-surface);
    border-bottom: 1px solid var(--color-border);
    padding-block: 0.4rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .compliance-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .compliance-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 500;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background-color: var(--color-success);
    box-shadow: 0 0 8px var(--color-success);
  }

  .compliance-title {
    color: var(--color-text-main);
    font-weight: 600;
  }

  .compliance-sep {
    color: var(--color-text-faint);
  }

  .compliance-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .compliance-area {
    color: var(--color-text-body);
  }

  .compliance-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-main);
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .compliance-phone:hover {
    color: var(--color-brand);
  }

  @media (max-width: 768px) {
    .compliance-sub,
    .compliance-area,
    .compliance-sep {
      display: none;
    }
  }

  /* ------------------------------------------------------------
     Main Sticky Navbar
     ------------------------------------------------------------ */
  .site-header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: var(--space-4);
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo {
    height: 38px;
    width: auto;
    max-height: 38px;
    object-fit: contain;
    aspect-ratio: 400 / 118;
    display: block;
    transition: opacity var(--transition-fast);
  }

  .brand:hover .brand-logo {
    opacity: 0.9;
  }

  .brand-divider {
    display: block;
    width: 1px;
    height: 22px;
    background: var(--color-border-medium);
  }

  .brand-subtitle {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.3vw, 1.75rem);
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-body);
    padding: 0.4rem 0.2rem;
    transition: color var(--transition-fast);
    position: relative;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-text-main);
  }

  .nav-link:hover::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-brand);
    border-radius: 2px;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .btn-phone {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-medium);
    background: #ffffff;
    color: var(--color-text-main);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .btn-phone:hover {
    border-color: var(--color-brand);
    background: var(--color-brand-tint);
    color: var(--color-brand);
  }

  .icon-phone {
    width: 16px;
    height: 16px;
    color: var(--color-brand);
  }

  .btn-quote {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-full);
    background-color: var(--color-cta);
    color: var(--color-cta-contrast);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.01em;
    transition: all var(--transition-fast);
    box-shadow: 0 2px 10px rgba(249, 115, 22, 0.25);
    white-space: nowrap;
  }

  .btn-quote:hover {
    background-color: var(--color-cta-hover);
    transform: translateY(-1px);
    box-shadow: var(--color-cta-glow);
  }

  .icon-arrow {
    width: 14px;
    height: 14px;
    transition: transform var(--transition-fast);
  }

  .btn-quote:hover .icon-arrow {
    transform: translateX(2px);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    cursor: pointer;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .mobile-toggle:hover {
    background: var(--color-bg-surface-hover);
    border-color: var(--color-border-medium);
  }

  .hamburger-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 20px;
    height: 16px;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    border-radius: 2px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }

    .btn-phone {
      display: inline-flex;
    }

    .mobile-toggle {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .brand-divider,
    .brand-subtitle {
      display: none;
    }

    .brand-logo {
      height: 32px;
    }
  }

  @media (max-width: 480px) {
    .btn-quote {
      display: none;
    }
  }
</style>
