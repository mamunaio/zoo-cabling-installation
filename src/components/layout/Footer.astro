---
import { business } from '../../config/business';

const currentYear = new Date().getFullYear();

interface FooterNavLink {
  label: string;
  href: string;
}

const onPageLinks: readonly FooterNavLink[] = [
  { label: 'Cabling Services', href: '#services' },
  { label: 'Ethernet vs Wi-Fi', href: '#comparison' },
  { label: 'Installation Craftsmanship', href: '#craftsmanship' },
  { label: 'Frequently Asked Questions', href: '#faq' },
  { label: 'Request an Estimate', href: '#quote' },
];
---

<footer class="site-footer" aria-label="Site Footer">
  <div class="container footer-container">
    <!-- Main Footer Grid -->
    <div class="footer-grid">
      <!-- Column 1: Brand & Overview -->
      <div class="footer-brand-col">
        <a href="/" class="footer-brand" aria-label="Zoo Computer Repairs — Data & Ethernet Cabling">
          <img
            src="/images/zoologo.png"
            alt="Zoo Computer Repairs — Data & Ethernet Cabling"
            class="footer-logo"
            width="400"
            height="118"
            loading="lazy"
            decoding="async"
          />
          <span class="footer-division" aria-hidden="true">Data &amp; Ethernet Cabling</span>
        </a>

        <p class="brand-desc">
          Professional Cat6 and Cat6A structured data cabling for homes and commercial businesses across Brisbane and surrounding regions.
        </p>
      </div>

      <!-- Column 2: On-Page Navigation Links -->
      <div class="footer-nav-col">
        <h3 class="footer-col-title">Navigation</h3>
        <ul class="footer-links">
          {onPageLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="link-chevron" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Service Area & Direct Contact -->
      <div class="footer-contact-col">
        <h3 class="footer-col-title">Service &amp; Contact</h3>

        <div class="contact-item">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <div class="contact-body">
            <span class="contact-label">Direct Phone</span>
            <a href={`tel:${business.phoneTel}`} class="contact-phone" aria-label={`Call ${business.phone}`}>
              {business.phone}
            </a>
          </div>
        </div>

        <div class="contact-item">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <div class="contact-body">
            <span class="contact-label">Service Area</span>
            <span class="contact-value">{business.serviceArea}</span>
            <a
              href="https://www.zoorepairs.com.au/suburbs-that-we-service/"
              target="_blank"
              rel="noopener noreferrer"
              class="suburbs-footer-link"
            >
              <span>View suburbs that we service</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-ext" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar: Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} {business.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #060a14;
    border-top: 1px solid var(--color-border);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    color: var(--color-text-muted);
    position: relative;
    overflow: hidden;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand-col {
      grid-column: span 2;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.35fr 1fr 1.25fr;
      gap: clamp(2.5rem, 4vw, 4.5rem);
    }
  }

  /* ------------------------------------------------------------
     Brand Column
     ------------------------------------------------------------ */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    text-decoration: none;
    width: fit-content;
  }

  .footer-logo {
    height: 40px;
    width: auto;
    max-height: 40px;
    object-fit: contain;
    aspect-ratio: 400 / 118;
    display: block;
    transition: opacity var(--transition-fast);
  }

  .footer-brand:hover .footer-logo {
    opacity: 0.9;
  }

  .footer-division {
    font-size: var(--text-xs);
    color: var(--color-accent-cyan-light);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .brand-desc {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-body);
    max-width: 40ch;
  }

  /* ------------------------------------------------------------
     Navigation Column
     ------------------------------------------------------------ */
  .footer-col-title {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .link-chevron {
    width: 14px;
    height: 14px;
    color: var(--color-cta);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-text-main);
    transform: translateX(2px);
  }

  .footer-link:hover .link-chevron {
    transform: translateX(2px);
  }

  /* ------------------------------------------------------------
     Contact & Service Area Column
     ------------------------------------------------------------ */
  .footer-contact-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .contact-icon {
    width: 18px;
    height: 18px;
    color: var(--color-cta);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .contact-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .contact-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-faint);
  }

  .contact-phone {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-main);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .contact-phone:hover {
    color: var(--color-cta);
  }

  .contact-value {
    font-size: var(--text-sm);
    color: var(--color-text-body);
  }

  .suburbs-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-cyan-light);
    margin-top: 0.25rem;
    transition: color var(--transition-fast);
  }

  .suburbs-footer-link:hover {
    color: var(--color-text-main);
    text-decoration: underline;
  }

  .icon-ext {
    width: 12px;
    height: 12px;
  }

  /* ------------------------------------------------------------
     Bottom Bar
     ------------------------------------------------------------ */
  .footer-bottom {
    padding-top: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    line-height: 1.5;
  }
</style>
