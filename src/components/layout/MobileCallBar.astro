---
import { business } from '../../config/business';
---

<aside class="mobile-call-bar" aria-label="Mobile quick contact actions">
  <div class="call-bar-container">
    <a href={`tel:${business.phoneTel}`} class="bar-btn bar-btn-call" aria-label={`Call ${business.phone}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="bar-icon" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      <span>Call {business.phone}</span>
    </a>

    <a href={business.quoteUrl} class="bar-btn bar-btn-quote" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="bar-icon" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
      <span>Get Quote</span>
    </a>
  </div>
</aside>

<style>
  .mobile-call-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 45;
    background: rgba(10, 15, 29, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid var(--color-border-medium);
    padding-top: 0.6rem;
    padding-inline: var(--space-4);
    padding-bottom: calc(0.6rem + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.5);
  }

  @media (min-width: 768px) {
    .mobile-call-bar {
      display: none;
    }
  }

  .call-bar-container {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--space-3);
    max-width: 480px;
    margin-inline: auto;
  }

  .bar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.6rem;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition: transform var(--transition-fast), background var(--transition-fast);
  }

  .bar-btn:active {
    transform: scale(0.98);
  }

  .bar-btn-call {
    background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-strong) 100%);
    color: #ffffff;
    border: 1px solid var(--color-brand-border);
    box-shadow: 0 2px 10px rgba(37, 99, 235, 0.35);
  }

  .bar-btn-quote {
    background: var(--color-cta);
    color: var(--color-cta-contrast);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 2px 10px rgba(249, 115, 22, 0.3);
  }

  .bar-icon {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }
</style>
