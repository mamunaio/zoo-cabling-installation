---
import { business } from '../../config/business';

interface NavLink {
  label: string;
  href: string;
}

const navLinks: readonly NavLink[] = [
  { label: 'About Us', href: 'https://www.zoorepairs.com.au/about-us/' },
  { label: 'Computer Services', href: 'https://www.zoorepairs.com.au/computer-services/' },
  { label: 'Remote', href: 'https://www.zoorepairs.com.au/remote/' },
  { label: 'Reviews', href: 'https://www.zoorepairs.com.au/reviews/' },
  { label: 'Blog', href: 'https://www.zoorepairs.com.au/blog/' },
  { label: 'Contact', href: 'https://www.zoorepairs.com.au/contact/' },
];
---

<div
  class="mobile-nav"
  id="mobile-nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
  aria-hidden="true"
>
  <!-- Dark Backdrop -->
  <div class="mobile-nav-backdrop" id="mobile-nav-backdrop" tabindex="-1"></div>

  <!-- Slide-out Navigation Panel -->
  <div class="mobile-nav-panel">
    <!-- Panel Header -->
    <div class="panel-header">
      <div class="panel-brand">
        <span class="panel-brand-name">{business.name}</span>
        <span class="panel-brand-sub">Data &amp; Cabling</span>
      </div>

      <button
        type="button"
        class="panel-close"
        id="mobile-nav-close"
        aria-label="Close mobile navigation menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-close" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <nav class="panel-nav" aria-label="Mobile Menu Links">
      <ul class="panel-list">
        {navLinks.map((item) => (
          <li class="panel-item">
            <a href={item.href} class="mobile-nav-link">
              <span>{item.label}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-nav-arrow" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Drawer Conversion Actions -->
    <div class="panel-actions">
      <a href={business.quoteUrl} class="mobile-cta-btn quote-cta" target="_blank" rel="noopener noreferrer">
        <span>Get a Free Quote</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="icon-arrow" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <a href={`tel:${business.phoneTel}`} class="mobile-cta-btn phone-cta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-phone" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Call {business.phone}</span>
      </a>

      <div class="panel-meta">
        <p class="meta-label">ACMA Registered Telecommunications Cablers</p>
        <p class="meta-area">{business.serviceArea}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    pointer-events: none;
    overflow: hidden;
    transition: visibility var(--transition-normal);
  }

  .mobile-nav.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  /* Backdrop */
  .mobile-nav-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 7, 18, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .mobile-nav.is-open .mobile-nav-backdrop {
    opacity: 1;
  }

  /* Slide Panel */
  .mobile-nav-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 320px;
    background: #ffffff;
    border-left: 1px solid var(--color-border);
    box-shadow: -8px 0 32px rgba(15, 23, 42, 0.15);
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    transform: translateX(100%);
    transition: transform var(--transition-normal);
    overflow-y: auto;
  }

  .mobile-nav.is-open .mobile-nav-panel {
    transform: translateX(0);
  }

  /* Panel Header */
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .panel-brand {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .panel-brand-name {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .panel-brand-sub {
    font-size: 0.7rem;
    color: var(--color-brand);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .panel-close {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .panel-close:hover {
    color: var(--color-text-main);
    background: var(--color-bg-surface-hover);
  }

  .icon-close {
    width: 20px;
    height: 20px;
  }

  /* Links List */
  .panel-nav {
    flex: 1;
    padding-block: var(--space-4);
  }

  .panel-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem var(--space-3);
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-body);
    transition: all var(--transition-fast);
  }

  .mobile-nav-link:hover {
    color: var(--color-text-main);
    background: var(--color-bg-surface);
    padding-left: var(--space-4);
  }

  .icon-nav-arrow {
    width: 16px;
    height: 16px;
    color: var(--color-text-faint);
  }

  /* Panel Actions */
  .panel-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .mobile-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .quote-cta {
    background-color: var(--color-cta);
    color: var(--color-cta-contrast);
    box-shadow: 0 2px 10px rgba(249, 115, 22, 0.25);
  }

  .quote-cta:hover {
    background-color: var(--color-cta-hover);
  }

  .phone-cta {
    background-color: var(--color-bg-surface);
    color: var(--color-text-main);
    border: 1px solid var(--color-border-medium);
  }

  .phone-cta:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .icon-arrow,
  .icon-phone {
    width: 16px;
    height: 16px;
  }

  .panel-meta {
    margin-top: var(--space-2);
    font-size: 0.72rem;
    color: var(--color-text-faint);
    line-height: 1.4;
    text-align: center;
  }

  .meta-label {
    color: var(--color-text-muted);
    font-weight: 500;
  }
</style>

<script>
  function initMobileNav() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const closeBtn = document.getElementById('mobile-nav-close');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const drawer = document.getElementById('mobile-nav-drawer');
    const links = document.querySelectorAll('.mobile-nav-link, .mobile-cta-btn');

    if (!toggleBtn || !drawer) return;

    function openDrawer() {
      drawer?.classList.add('is-open');
      drawer?.setAttribute('aria-hidden', 'false');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeDrawer() {
      drawer?.classList.remove('is-open');
      drawer?.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggleBtn?.focus();
    }

    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.contains('is-open');
      if (isOpen) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    links.forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });
  }

  // Initialize on load & compatible with Astro transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileNav);
  } else {
    initMobileNav();
  }
  document.addEventListener('astro:page-load', initMobileNav);
</script>
