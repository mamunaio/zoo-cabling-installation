---
// BackToTop.astro — Premium Floating Back-to-Top with Smooth Scroll & Progress Track
---

<button
  type="button"
  id="back-to-top"
  class="back-to-top"
  aria-label="Scroll back to top of page"
  title="Back to top"
>
  <!-- Circular Scroll Progress Meter -->
  <svg class="progress-ring" viewBox="0 0 44 44" aria-hidden="true">
    <circle
      class="progress-ring-track"
      cx="22"
      cy="22"
      r="19"
      fill="none"
      stroke-width="2.5"
    />
    <circle
      class="progress-ring-bar"
      cx="22"
      cy="22"
      r="19"
      fill="none"
      stroke-width="2.5"
    />
  </svg>

  <!-- High-Tech Arrow Up Icon -->
  <span class="icon-wrap" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </span>
</button>

<script>
  function initBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    const circle = btn.querySelector<SVGCircleElement>('.progress-ring-bar');
    const radius = 19;
    const circumference = 2 * Math.PI * radius;

    if (circle) {
      circle.style.strokeDasharray = `${circumference} ${circumference}`;
      circle.style.strokeDashoffset = `${circumference}`;
    }

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;

      // Show/Hide threshold (appears after scrolling 360px)
      if (scrollTop > 360) {
        btn?.classList.add('is-visible');
      } else {
        btn?.classList.remove('is-visible');
      }

      // Update circular progress meter
      if (circle && scrollHeight > 0) {
        const progress = Math.min(Math.max(scrollTop / scrollHeight, 0), 1);
        const offset = circumference - progress * circumference;
        circle.style.strokeDashoffset = `${offset}`;
      }
    }

    // Smooth scroll to top on click
    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });

    // Throttled scroll listener
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            updateProgress();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    // Initial check
    updateProgress();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBackToTop);
  } else {
    initBackToTop();
  }
  document.addEventListener('astro:page-load', initBackToTop);
</script>

<style>
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 40;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--color-border);
    box-shadow:
      0 4px 16px -2px rgba(15, 23, 42, 0.12),
      0 0 0 1px rgba(15, 23, 42, 0.04);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(0.92);
    transition:
      opacity 280ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 280ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      background-color var(--transition-fast);
  }

  /* Safe Area & Mobile Offset to prevent collision with MobileCallBar */
  @media (max-width: 767px) {
    .back-to-top {
      bottom: calc(72px + env(safe-area-inset-bottom, 0px) + 0.85rem);
      right: 1.15rem;
      width: 44px;
      height: 44px;
    }
  }

  /* Visible State */
  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* Hover & Active Interactions */
  .back-to-top:hover {
    border-color: rgba(249, 115, 22, 0.5);
    background: #ffffff;
    box-shadow:
      0 8px 24px -4px rgba(15, 23, 42, 0.16),
      0 0 16px -2px rgba(249, 115, 22, 0.25);
    transform: translateY(-3px) scale(1.04);
  }

  .back-to-top:active {
    transform: translateY(0) scale(0.95);
  }

  .back-to-top:focus-visible {
    outline: none;
    box-shadow:
      var(--ring-focus-cta),
      0 4px 16px rgba(15, 23, 42, 0.15);
  }

  /* Progress Ring Overlay */
  .progress-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    pointer-events: none;
  }

  .progress-ring-track {
    stroke: #e2e8f0;
  }

  .progress-ring-bar {
    stroke: var(--color-cta);
    stroke-linecap: round;
    transition: stroke-dashoffset 80ms linear;
  }

  .back-to-top:hover .progress-ring-bar {
    stroke: #ea580c;
  }

  /* Center Icon Wrap & Arrow */
  .icon-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .arrow-icon {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }

  .back-to-top:hover .arrow-icon {
    transform: translateY(-2px);
    color: var(--color-cta);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
      transform: none;
    }
    .arrow-icon {
      transition: none;
      transform: none;
    }
    .progress-ring-bar {
      transition: none;
    }
  }
</style>
